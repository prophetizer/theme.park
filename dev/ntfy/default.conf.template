map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name localhost;

    # ntfy serves its web app and its API on the same paths (/<topic> is the
    # topic page in a browser and the publish/subscribe endpoint for clients).
    # sub_filter only rewrites text/html, so JSON, SSE and WebSocket traffic
    # passes through untouched; buffering is off for the streams.
    location / {
        proxy_pass http://ntfy:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        sub_filter_once on;
        sub_filter '</head>' '<link rel="stylesheet" href="http://localhost:18871/css/base/ntfy/ntfy-base.css"><link rel="stylesheet" href="http://localhost:18871/css/${TP_THEME_FOLDER}/${TP_THEME}.css"></head>';
    }
}
